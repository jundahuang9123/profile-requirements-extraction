# The default runs the rules baseline without credentials or paid model calls.
RRS_LLM_PROVIDER=disabled
# For live extraction, choose a provider and its model explicitly.
# RRS_LLM_PROVIDER=openai-compatible
# RRS_LLM_BASE_URL=https://api.openai.com/v1
# RRS_LLM_MODEL=
# RRS_LLM_API_KEY=
# Optional OpenAI-compatible reasoning control, omitted when unset.
# Ollama Qwen JSON tasks can use none. For reasoning models such as GPT-OSS the
# response cap also pays for reasoning, so low leaves more of it for the JSON answer.
# Check the recorded reasoning tokens to see whether the endpoint honours the setting.
# RRS_LLM_REASONING_EFFORT=low
# Seconds per HTTP attempt. Raise it when large responses time out; retries cannot help there.
# RRS_LLM_TIMEOUT=240
# OpenAI-compatible requests share one slot per endpoint in this server process.
RRS_LLM_MAX_CONCURRENCY=1
# Extra attempts after HTTP 429 (0-8) and after a timeout, dropped connection or
# HTTP 500/502/503/504 (0-3). Both share the wait budget in seconds (0-600).
RRS_LLM_RATE_LIMIT_RETRIES=5
RRS_LLM_TRANSIENT_RETRIES=2
RRS_LLM_RETRY_BACKOFF=2
RRS_LLM_RETRY_WAIT_BUDGET=120
# Alternatively: RRS_LLM_PROVIDER=anthropic and ANTHROPIC_API_KEY.
RRS_AGENT_CONCURRENCY=4
RRS_AGENT_CACHE=.rrs-agent-cache
RRS_REQUIREMENT_STORE=requirement-sets
RQ1_WORKFLOW_STORE=.rq1-workflow/workflow.sqlite3
# Automatic role selection scans the whole corpus, at most 128 source batches; each
# batch costs up to four selector calls (HealthDCAT-AP needs 36, mobilityDCAT-AP 61).
# Optional cap (1-128): a run whose corpus needs more batches is refused.
# RQ1_ROLE_SELECTION_MAX_BATCHES=64
RQ1_LOCAL_REVIEWER=local-reviewer
